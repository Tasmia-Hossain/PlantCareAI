@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-card-accent"></div>

        <div class="auth-card-body">

            <div class="auth-brand">
                🌿
            </div>

            <h1 class="auth-title">Welcome back</h1>

            <p class="auth-subtitle">
                Log in to manage your plants and care records.
            </p>

            <form id="account" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"
                     role="alert"></div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Email"
                           class="form-control"
                           autocomplete="username"
                           aria-required="true"
                           placeholder="name@example.com" />

                    <label asp-for="Input.Email">
                        Email
                    </label>

                    <span asp-validation-for="Input.Email"
                          class="text-danger"></span>
                </div>

                <div class="form-floating mb-3">
                    <input asp-for="Input.Password"
                           class="form-control"
                           autocomplete="current-password"
                           aria-required="true"
                           placeholder="password" />

                    <label asp-for="Input.Password">
                        Password
                    </label>

                    <span asp-validation-for="Input.Password"
                          class="text-danger"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">

                    <div class="form-check">
                        <input class="form-check-input"
                               asp-for="Input.RememberMe" />

                        <label class="form-check-label"
                               asp-for="Input.RememberMe">
                            Remember me
                        </label>
                    </div>

                    <a id="forgot-password"
                       asp-page="./ForgotPassword"
                       class="small">
                        Forgot password?
                    </a>

                </div>

                <button id="login-submit"
                        type="submit"
                        class="w-100 btn btn-primary btn-lg">
                    Log in
                </button>

                <div class="text-center mt-4">

                    <span class="text-muted">
                        Don't have an account?
                    </span>

                    <a asp-page="./Register"
                       asp-route-returnUrl="@Model.ReturnUrl"
                       class="fw-semibold">
                        Create one
                    </a>

                </div>

            </form>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}