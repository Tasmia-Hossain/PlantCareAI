@page
@model IndexModel

@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="text-center mb-4">

                <div class="auth-brand">
                    🌱
                </div>

                <h1 class="fw-bold">
                    My Profile
                </h1>

                <p class="text-muted">
                    Manage your PlantCareAI account.
                </p>

            </div>

            <div class="form-card">

                <div class="form-card-accent"></div>

                <div class="card-body p-4 p-md-5">

                    <form id="profile-form"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>

                        <div class="mb-3">

                            <label class="form-label">
                                Email
                            </label>

                            <input value="@Model.Username"
                                   class="form-control"
                                   disabled />

                        </div>

                        <div class="mb-4">

                            <label asp-for="Input.PhoneNumber"
                                   class="form-label">
                                Phone Number
                                <span class="text-muted">
                                    (Optional)
                                </span>
                            </label>

                            <input asp-for="Input.PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="Input.PhoneNumber"
                                  class="text-danger">
                            </span>

                        </div>

                        <button type="submit"
                                class="btn btn-success">
                            Save Changes
                        </button>

                    </form>

                    <hr class="my-4" />

                    <a asp-area="Identity"
                       asp-page="/Account/Manage/ChangePassword"
                       class="btn btn-outline-secondary">
                        Change Password
                    </a>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}