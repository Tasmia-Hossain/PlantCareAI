@model PlantCareAI.Models.JournalEntry

@{
    ViewData["Title"] = "Add Journal Entry";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="form-card">

                <div class="form-card-accent"></div>

                <div class="card-body p-4 p-md-5">

                    <div class="d-flex align-items-center gap-3 mb-4">

                        <div class="stat-icon m-0"
                             style="background:#fdf0e7; color:var(--terracotta-dark);">
                            📖
                        </div>

                        <div>
                            <h2 class="fw-bold mb-0">
                                Add Journal Entry
                            </h2>

                            <p class="text-muted mb-0">
                                Record something about
                                <strong>@ViewBag.PlantName</strong>
                            </p>
                        </div>

                    </div>


                    <form asp-action="AddJournal"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <input type="hidden"
                               asp-for="PlantId" />


                        <!-- Date & Time -->
                        <div class="mb-3">

                            <label asp-for="CreatedAt"
                                   class="form-label">
                                Date &amp; Time
                            </label>

                            <input asp-for="CreatedAt"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" />

                            <span asp-validation-for="CreatedAt"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Title -->
                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. New leaves appeared" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Journal Content -->
                        <div class="mb-4">

                            <label asp-for="Content"
                                   class="form-label">
                                Journal Entry
                            </label>

                            <textarea asp-for="Content"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Write about your plant..."></textarea>

                            <span asp-validation-for="Content"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary btn-lg">
                                📖 Save Entry
                            </button>

                            <a asp-controller="Plants"
                               asp-action="Details"
                               asp-route-id="@Model.PlantId"
                               class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>
    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}