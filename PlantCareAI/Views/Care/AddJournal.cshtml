@model PlantCareAI.Models.JournalEntry

@{
    ViewData["Title"] = "Add Journal Entry";
}

<div class="container py-4">

    <div class="mb-4">
        <h1 class="fw-bold">Add Journal Entry</h1>
        <p class="text-muted">
            Record something about @ViewBag.PlantName.
        </p>
    </div>

    <div class="row">

        <div class="col-md-7">

            <div class="card shadow-sm border-0">

                <div class="card-body p-4">

                    <form asp-action="AddJournal" method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input type="hidden"
                               asp-for="PlantId" />

                        <div class="mb-3">

                            <label asp-for="Title"
                                   class="form-label">
                                Title
                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. New leaves appeared" />

                            <span asp-validation-for="Title"
                                  class="text-danger"></span>

                        </div>

                        <div class="mb-4">

                            <label asp-for="Content"
                                   class="form-label">
                                Journal Entry
                            </label>

                            <textarea asp-for="Content"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Write about your plant..."></textarea>

                            <span asp-validation-for="Content"
                                  class="text-danger"></span>

                        </div>

                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-primary">
                                Save Entry
                            </button>

                            <a asp-controller="Plants"
                               asp-action="Details"
                               asp-route-id="@Model.PlantId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}