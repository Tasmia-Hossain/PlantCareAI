@model PlantCareAI.Models.HealthRecord

@{
    ViewData["Title"] = "Record Plant Health";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-md-8">

            <div class="form-card">
                <div class="form-card-accent"></div>
                <div class="card-body p-4 p-md-5">

                    <div class="d-flex align-items-center gap-3 mb-4">
                        <div class="stat-icon m-0" style="background:#fbeee9; color:#b3392f;">❤️</div>
                        <div>
                            <h2 class="fw-bold mb-0">Record Plant Health</h2>
                            <p class="text-muted mb-0">
                                Record the current health condition of <strong>@ViewBag.PlantName</strong>
                            </p>
                        </div>
                    </div>

                    <form asp-action="AddHealth"
                          method="post">

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <input type="hidden"
                               asp-for="PlantId" />

                        <div class="mb-3">

                            <label asp-for="RecordedAt"
                                   class="form-label">
                            </label>

                            <input asp-for="RecordedAt"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" />

                        </div>


                        <div class="mb-3">

                            <label asp-for="HealthStatus"
                                   class="form-label">
                            </label>

                            <select asp-for="HealthStatus"
                                    class="form-select">

                                <option value="">Select health status</option>
                                <option value="Healthy">💚 Healthy</option>
                                <option value="Needs Attention">⚠️ Needs Attention</option>
                                <option value="Recovering">🌱 Recovering</option>
                                <option value="Critical">🚨 Critical</option>

                            </select>

                            <span asp-validation-for="HealthStatus"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-3">

                            <label asp-for="Symptoms"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Symptoms"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe any visible symptoms...">
                            </textarea>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label">
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Additional observations...">
                            </textarea>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger btn-lg">
                                ❤️ Save Health Record
                            </button>

                            <a asp-controller="Plants"
                               asp-action="Details"
                               asp-route-id="@Model.PlantId"
                               class="btn btn-outline-secondary btn-lg">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
