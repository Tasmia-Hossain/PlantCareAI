@model PlantCareAI.Models.HealthRecord

@{
    ViewData["Title"] = "Edit Health Record";
}

<div class="container page-header">
    <span class="section-eyebrow">Update care record</span>

    <h1 class="fw-bold mt-1">
        🩺 Edit Health Record
    </h1>

    <p class="text-muted mb-0">
        Update health information for
        <strong>@ViewBag.PlantName</strong>.
    </p>
</div>

<div class="container pb-5">

    <div class="row justify-content-center">

        <div class="col-md-7">

            <div class="form-card">

                <div class="form-card-accent"></div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="EditHealth"
                          method="post">

                        <input type="hidden"
                               asp-for="Id" />

                        <input type="hidden"
                               asp-for="PlantId" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3">
                        </div>


                        <!-- Date & Time -->
                        <div class="mb-3">

                            <label asp-for="RecordedAt"
                                   class="form-label">
                                Date &amp; Time
                            </label>

                            <input asp-for="RecordedAt"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control" />

                            <span asp-validation-for="RecordedAt"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Health Status -->
                        <div class="mb-3">

                            <label asp-for="HealthStatus"
                                   class="form-label">
                                Health Status
                            </label>

                            <input asp-for="HealthStatus"
                                   class="form-control"
                                   placeholder="e.g. Healthy, Needs Attention" />

                            <span asp-validation-for="HealthStatus"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Symptoms -->
                        <div class="mb-3">

                            <label asp-for="Symptoms"
                                   class="form-label">
                                Symptoms
                            </label>

                            <textarea asp-for="Symptoms"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Describe any symptoms..."></textarea>

                            <span asp-validation-for="Symptoms"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Notes -->
                        <div class="mb-4">

                            <label asp-for="Notes"
                                   class="form-label">
                                Notes
                            </label>

                            <textarea asp-for="Notes"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Add additional notes..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->
                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-success">
                                💾 Save Changes
                            </button>

                            <a asp-controller="Plants"
                               asp-action="Details"
                               asp-route-id="@Model.PlantId"
                               class="btn btn-outline-secondary">
                                Cancel
                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}