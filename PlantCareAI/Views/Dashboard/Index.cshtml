@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            🌱 PlantCareAI Dashboard
        </h1>

        <p class="text-muted">
            Keep your plants healthy and stay on top of their care.
        </p>

    </div>


    <!-- Statistics -->

    <div class="row g-4 mb-5">

        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Total Plants
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalPlants
                    </h2>

                    <span>
                        🌿 Plants in your garden
                    </span>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Healthy Plants
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.HealthyPlants
                    </h2>

                    <span>
                        ❤️ Looking healthy
                    </span>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Need Attention
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.NeedsAttention
                    </h2>

                    <span>
                        ⚠️ Check these plants
                    </span>

                </div>

            </div>

        </div>


        <div class="col-md-6 col-lg-3">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body">

                    <h6 class="text-muted">
                        Watering Records
                    </h6>

                    <h2 class="fw-bold">
                        @ViewBag.TotalWaterings
                    </h2>

                    <span>
                        💧 Care activities
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- Quick Actions -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                Quick Actions
            </h3>

            <div class="d-flex flex-wrap gap-3">

                <a asp-controller="Plants"
                   asp-action="Index"
                   class="btn btn-success">
                    🌿 My Plants
                </a>

                <a asp-controller="Plants"
                   asp-action="Create"
                   class="btn btn-outline-success">
                    + Add Plant
                </a>

            </div>

        </div>

    </div>

</div>