@{
    ViewData["Title"] = "Dashboard";
}

<div class="container py-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            🌱 PlantCareAI Dashboard
        </h1>

        <p class="text-muted">
            Keep your plants healthy and stay on top of their care.
        </p>

    </div>


    <!-- Statistics -->

    <div class="row g-4 mb-4">

        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">🌿 Total Plants</div>
                    <h2 class="fw-bold mt-2">
                        @ViewBag.TotalPlants
                    </h2>
                </div>
            </div>
        </div>


        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">💚 Healthy</div>
                    <h2 class="fw-bold mt-2">
                        @ViewBag.HealthyPlants
                    </h2>
                </div>
            </div>
        </div>


        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">⚠️ Needs Attention</div>
                    <h2 class="fw-bold mt-2">
                        @ViewBag.NeedsAttention
                    </h2>
                </div>
            </div>
        </div>


        <div class="col-md-6 col-lg-3">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-body">
                    <div class="text-muted">💧 Waterings</div>
                    <h2 class="fw-bold mt-2">
                        @ViewBag.TotalWaterings
                    </h2>
                </div>
            </div>
        </div>

    </div>


    <!-- Total Fertilizations -->

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <div class="text-muted">
                🌱 Total Fertilizations
            </div>

            <h2 class="fw-bold mt-2">
                @ViewBag.TotalFertilizations
            </h2>

        </div>

    </div>


    <!-- Quick Actions -->

    <div class="card shadow-sm border-0">

        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                Quick Actions
            </h3>

            <div class="d-flex flex-wrap gap-3">

                <a asp-controller="Plants"
                   asp-action="Index"
                   class="btn btn-success">
                    🌿 My Plants
                </a>

                <a asp-controller="Plants"
                   asp-action="Create"
                   class="btn btn-outline-success">
                    + Add Plant
                </a>

            </div>

        </div>

    </div>

</div>

