@model IEnumerable<PlantCareAI.Models.Plant>

@{
    ViewData["Title"] = "My Plants";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold mb-1">My Plants</h1>
            <p class="text-muted mb-0">Manage and track your plants.</p>
        </div>

        <a asp-action="Create" class="btn btn-success">
            + Add Plant
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <h4>No plants added yet.</h4>
            <p class="text-muted">Start by adding your first plant.</p>

            <a asp-action="Create" class="btn btn-success">
                Add Your First Plant
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var plant in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card h-100 shadow-sm border-0">

                        @if (!string.IsNullOrEmpty(plant.ImageUrl))
                        {
                            <img src="@plant.ImageUrl"
                                 class="card-img-top"
                                 alt="@plant.Name"
                                 style="height:220px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:220px;">
                                <span class="text-muted">No image</span>
                            </div>
                        }

                        <div class="card-body">

                            <h4 class="card-title fw-bold">
                                @plant.Name
                            </h4>

                            <p class="text-muted fst-italic">
                                @plant.Species
                            </p>

                            @if (!string.IsNullOrEmpty(plant.Location))
                            {
                                <p class="mb-2">
                                    <strong>Location:</strong> @plant.Location
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(plant.SunlightRequirement))
                            {
                                <p class="mb-2">
                                    <strong>Sunlight:</strong> @plant.SunlightRequirement
                                </p>
                            }

                            @if (!string.IsNullOrEmpty(plant.WateringFrequency))
                            {
                                <p class="mb-3">
                                    <strong>Watering:</strong> @plant.WateringFrequency
                                </p>
                            }

                            <div class="d-flex gap-2">

                                <a asp-action="Details"
                                   asp-route-id="@plant.Id"
                                   class="btn btn-outline-success btn-sm">
                                    View
                                </a>

                                <a asp-action="Edit"
                                   asp-route-id="@plant.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <a asp-action="Delete"
                                   asp-route-id="@plant.Id"
                                   class="btn btn-outline-danger btn-sm">
                                    Delete
                                </a>

                            </div>

                        </div>
                    </div>

                </div>
            }

        </div>
    }

</div>