@model IEnumerable<PlantCareAI.Models.Plant>

@{
    ViewData["Title"] = "My Plants";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">🌿 My Plants</h1>
            <p class="text-muted mb-0">
                Keep track of your plants and their care.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-success">
            + Add Plant
        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">

                <h3>No plants yet 🌱</h3>

                <p class="text-muted">
                    Add your first plant to start tracking its care.
                </p>

                <a asp-action="Create"
                   class="btn btn-success">
                    Add Your First Plant
                </a>

            </div>
        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var plant in Model)
            {
                <div class="col-md-6 col-lg-4">

                    <div class="card shadow-sm border-0 h-100">

                        @if (!string.IsNullOrEmpty(plant.ImageUrl))
                        {
                            <img src="@plant.ImageUrl"
                                 class="card-img-top"
                                 alt="@plant.Name"
                                 style="height:220px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center"
                                 style="height:220px;">
                                <span class="text-muted">
                                    No image
                                </span>
                            </div>
                        }

                        <div class="card-body">

                            <h4 class="fw-bold mb-1">
                                🌿 @plant.Name
                            </h4>

                            <p class="text-muted fst-italic">
                                @plant.Species
                            </p>

                            <div class="small text-muted mb-3">

                                @if (!string.IsNullOrEmpty(plant.Location))
                                {
                                    <div>📍 @plant.Location</div>
                                }

                                @if (!string.IsNullOrEmpty(plant.WateringFrequency))
                                {
                                    <div>💧 @plant.WateringFrequency</div>
                                }

                                @if (!string.IsNullOrEmpty(plant.SunlightRequirement))
                                {
                                    <div>☀️ @plant.SunlightRequirement</div>
                                }

                            </div>

                            <a asp-action="Details"
                               asp-route-id="@plant.Id"
                               class="btn btn-outline-success w-100">
                                View Plant
                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>