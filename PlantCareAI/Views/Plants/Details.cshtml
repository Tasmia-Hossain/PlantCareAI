@model PlantCareAI.Models.Plant

@{
    ViewData["Title"] = Model.Name;


    var latestHealth = Model.HealthRecords
        .OrderByDescending(h => h.RecordedAt)
        .FirstOrDefault();

    var status = latestHealth?.HealthStatus;

    var badgeClass = status switch
    {
        "Healthy" => "healthy",
        "Needs Attention" => "attention",
        "Recovering" => "recovering",
        "Critical" => "critical",
        _ => "unknown"
    };

    var badgeIcon = status switch
    {
        "Healthy" => "💚",
        "Needs Attention" => "⚠️",
        "Recovering" => "🌱",
        "Critical" => "🚨",
        _ => "🌿"
    };


}

<div class="container py-4">

    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">

        <div>
            <div class="d-flex align-items-center gap-2 mb-1">

                <h1 class="fw-bold mb-0">
                    🌿 @Model.Name
                </h1>

                <span class="badge-status @badgeClass">
                    @badgeIcon @(status ?? "Unrecorded")
                </span>

            </div>

            <p class="text-muted fst-italic mb-0">
                @Model.PlantType
            </p>
        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-controller="AI"
               asp-action="PlantHealth"
               asp-route-plantId="@Model.Id"
               class="btn btn-success">
                🤖 AI Health Check
            </a>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-outline-primary">
                Edit
            </a>

            <a asp-action="Delete"
               asp-route-id="@Model.Id"
               class="btn btn-outline-danger">
                Delete
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Back
            </a>

        </div>

    </div>


    <!-- Plant Overview -->
    <div class="card shadow-sm border-0 mb-4 rounded-xl overflow-hidden">

        <div class="row g-0">

            <!-- Plant Image -->
            <div class="col-md-5">

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl"
                         alt="@Model.Name"
                         class="img-fluid w-100 h-100"
                         style="object-fit: cover; min-height: 320px;" />
                }
                else
                {
                    <div class="plant-img-placeholder d-flex align-items-center justify-content-center"
                         style="height: 320px; font-size: 3rem;">
                        🌿
                    </div>
                }

            </div>


            <!-- Plant Information -->
            <div class="col-md-7">

                <div class="card-body p-4">

                    <h3 class="fw-bold mb-4">
                        Plant Information
                    </h3>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <p class="mb-4">
                            @Model.Description
                        </p>
                    }

                    <div class="row g-3">

                        <div class="col-sm-6">

                            <strong>📍 Location</strong>

                            <div class="text-muted">
                                @(Model.Location ?? "Not specified")
                            </div>

                        </div>

                        <div class="col-sm-6">

                            <strong>☀️ Sunlight</strong>

                            <div class="text-muted">
                                @(Model.SunlightRequirement ?? "Not specified")
                            </div>

                        </div>

                        <div class="col-sm-6">

                            <strong>💧 Watering</strong>

                            <div class="text-muted">
                                @(Model.WateringFrequency ?? "Not specified")
                            </div>

                        </div>

                        <div class="col-sm-6">

                            <strong>📅 Added</strong>

                            <div class="text-muted">
                                @Model.DateAdded.ToString("dd MMM yyyy")
                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Care Tracking -->
    <div class="row g-4">


        <!-- ================================================= -->
        <!-- WATERING -->
        <!-- ================================================= -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="fw-bold mb-0">
                            💧 Watering
                        </h4>

                        <a asp-controller="Care"
                           asp-action="AddWatering"
                           asp-route-plantId="@Model.Id"
                           class="btn btn-success btn-sm">
                            Mark as Watered
                        </a>

                    </div>

                    @if (Model.WateringRecords.Any())
                    {
                        <p class="text-muted">
                            Last watered:

                            <strong>
                                @(Model.WateringRecords
                                    .OrderByDescending(x => x.WateredAt)
                                    .First()
                                    .WateredAt
                                    .ToString("dd MMM yyyy, hh:mm tt"))
                            </strong>
                        </p>

                        <hr />

                        <h6 class="mb-3">
                            Recent Records
                        </h6>

                        <ul class="list-group list-group-flush">

                            @foreach (var record in Model.WateringRecords
                                .OrderByDescending(x => x.WateredAt)
                                .Take(5))
                            {
                                <li class="list-group-item px-0 bg-transparent">

                                    <div class="d-flex justify-content-between align-items-start gap-2">

                                        <div>

                                            <div>
                                                @record.WateredAt.ToString("dd MMM yyyy, hh:mm tt")
                                            </div>

                                            @if (!string.IsNullOrEmpty(record.Notes))
                                            {
                                                <small class="text-muted">
                                                    Notes: @record.Notes
                                                </small>
                                            }

                                        </div>

                                        <div class="d-flex gap-1 flex-shrink-0">

                                            <a asp-controller="Care"
                                               asp-action="EditWatering"
                                               asp-route-id="@record.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                Edit
                                            </a>

                                            <form asp-controller="Care"
                                                  asp-action="DeleteWatering"
                                                  asp-route-id="@record.Id"
                                                  method="post"
                                                  id="delete-watering-@record.Id">

                                                @Html.AntiForgeryToken()

                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        data-confirm-delete
                                                        data-confirm-target="delete-watering-@record.Id"
                                                        data-confirm-message="Delete this watering record? This can't be undone.">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </li>
                            }

                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No watering records yet.
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- FERTILIZING -->
        <!-- ================================================= -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="fw-bold mb-0">
                            🌱 Fertilizing
                        </h4>

                        <a asp-controller="Care"
                           asp-action="AddFertilizer"
                           asp-route-plantId="@Model.Id"
                           class="btn btn-outline-success btn-sm">
                            Add Record
                        </a>

                    </div>

                    @if (Model.FertilizingRecords.Any())
                    {
                        <p class="text-muted">
                            Last fertilized:

                            <strong>
                                @(Model.FertilizingRecords
                                    .OrderByDescending(x => x.FertilizedAt)
                                    .First()
                                    .FertilizedAt
                                    .ToString("dd MMM yyyy, hh:mm tt"))
                            </strong>
                        </p>

                        <hr />

                        <h6 class="mb-3">
                            Recent Records
                        </h6>

                        <ul class="list-group list-group-flush">

                            @foreach (var record in Model.FertilizingRecords
                                .OrderByDescending(x => x.FertilizedAt)
                                .Take(5))
                            {
                                <li class="list-group-item px-0 bg-transparent">

                                    <div class="d-flex justify-content-between align-items-start gap-2">

                                        <div>

                                            <div>
                                                @record.FertilizedAt.ToString("dd MMM yyyy, hh:mm tt")
                                            </div>

                                            @if (!string.IsNullOrEmpty(record.Fertilizer))
                                            {
                                                <div>
                                                    Fertilizer: @record.Fertilizer
                                                </div>
                                            }

                                            @if (!string.IsNullOrEmpty(record.Notes))
                                            {
                                                <small class="text-muted">
                                                    Notes: @record.Notes
                                                </small>
                                            }

                                        </div>

                                        <div class="d-flex gap-1 flex-shrink-0">

                                            <a asp-controller="Care"
                                               asp-action="EditFertilizer"
                                               asp-route-id="@record.Id"
                                               class="btn btn-outline-primary btn-sm">
                                                Edit
                                            </a>

                                            <form asp-controller="Care"
                                                  asp-action="DeleteFertilizer"
                                                  asp-route-id="@record.Id"
                                                  method="post"
                                                  id="delete-fertilizer-@record.Id">

                                                @Html.AntiForgeryToken()

                                                <button type="button"
                                                        class="btn btn-outline-danger btn-sm"
                                                        data-confirm-delete
                                                        data-confirm-target="delete-fertilizer-@record.Id"
                                                        data-confirm-message="Delete this fertilizer record? This can't be undone.">
                                                    Delete
                                                </button>

                                            </form>

                                        </div>

                                    </div>

                                </li>
                            }

                        </ul>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No fertilizing records yet.
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- HEALTH -->
        <!-- ================================================= -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="fw-bold mb-0">
                            ❤️ Health
                        </h4>

                        <a asp-controller="Care"
                           asp-action="AddHealth"
                           asp-route-plantId="@Model.Id"
                           class="btn btn-outline-danger btn-sm">
                            Record Health
                        </a>

                    </div>

                    @if (latestHealth != null)
                    {
                        <div class="d-flex justify-content-between align-items-start gap-2">

                            <div>

                                <p class="mb-2">
                                    <strong>Status:</strong>

                                    <span class="badge-status @badgeClass">
                                        @badgeIcon @latestHealth.HealthStatus
                                    </span>
                                </p>

                                @if (!string.IsNullOrEmpty(latestHealth.Symptoms))
                                {
                                    <p class="mb-2">
                                        <strong>Symptoms:</strong>
                                        @latestHealth.Symptoms
                                    </p>
                                }

                                @if (!string.IsNullOrEmpty(latestHealth.Notes))
                                {
                                    <p class="mb-2">
                                        <strong>Notes:</strong>
                                        @latestHealth.Notes
                                    </p>
                                }

                                <small class="text-muted">
                                    Recorded
                                    @latestHealth.RecordedAt.ToString("dd MMM yyyy, hh:mm tt")
                                </small>

                            </div>

                            <div class="d-flex gap-1 flex-shrink-0">

                                <a asp-controller="Care"
                                   asp-action="EditHealth"
                                   asp-route-id="@latestHealth.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit
                                </a>

                                <form asp-controller="Care"
                                      asp-action="DeleteHealth"
                                      asp-route-id="@latestHealth.Id"
                                      method="post"
                                      id="delete-health-@latestHealth.Id">

                                    @Html.AntiForgeryToken()

                                    <button type="button"
                                            class="btn btn-outline-danger btn-sm"
                                            data-confirm-delete
                                            data-confirm-target="delete-health-@latestHealth.Id"
                                            data-confirm-message="Delete this health record? This can't be undone.">
                                        Delete
                                    </button>

                                </form>

                            </div>

                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No health records yet.
                        </p>
                    }

                </div>

            </div>

        </div>


        <!-- ================================================= -->
        <!-- JOURNAL -->
        <!-- ================================================= -->

        <div class="col-md-6">

            <div class="card shadow-sm border-0 h-100">

                <div class="card-body p-4">

                    <div class="d-flex justify-content-between align-items-center mb-3">

                        <h4 class="fw-bold mb-0">
                            📖 Journal
                        </h4>

                        <a asp-controller="Care"
                           asp-action="AddJournal"
                           asp-route-plantId="@Model.Id"
                           class="btn btn-outline-primary btn-sm">
                            Add Entry
                        </a>

                    </div>

                    @if (Model.JournalEntries.Any())
                    {
                        @foreach (var entry in Model.JournalEntries
                            .OrderByDescending(x => x.CreatedAt)
                            .Take(3))
                        {
                            <div class="border-bottom pb-3 mb-3">

                                <div class="d-flex justify-content-between align-items-start gap-2">

                                    <div class="flex-grow-1">

                                        <h6 class="fw-bold mb-1">
                                            @entry.Title
                                        </h6>

                                        <p class="mb-1">
                                            @entry.Content
                                        </p>

                                        <small class="text-muted">
                                            @entry.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                                        </small>

                                    </div>

                                    <div class="d-flex gap-1 flex-shrink-0">

                                        <a asp-controller="Care"
                                           asp-action="EditJournal"
                                           asp-route-id="@entry.Id"
                                           class="btn btn-outline-primary btn-sm">
                                            Edit
                                        </a>

                                        <form asp-controller="Care"
                                              asp-action="DeleteJournal"
                                              asp-route-id="@entry.Id"
                                              method="post"
                                              id="delete-journal-@entry.Id">

                                            @Html.AntiForgeryToken()

                                            <button type="button"
                                                    class="btn btn-outline-danger btn-sm"
                                                    data-confirm-delete
                                                    data-confirm-target="delete-journal-@entry.Id"
                                                    data-confirm-message="Delete this journal entry? This can't be undone.">
                                                Delete
                                            </button>

                                        </form>

                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-muted mb-0">
                            No journal entries yet.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>

</div>
