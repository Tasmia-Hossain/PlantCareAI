@model PlantCareAI.Models.AiPlantAnalysisViewModel

@{
    ViewData["Title"] = "AI Plant Health Assistant";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">
                <span class="section-eyebrow">AI-powered</span>
                <h1 class="fw-bold mt-1">🤖 AI Plant Health Assistant</h1>
                <p class="text-muted">
                    Get AI-generated plant-care suggestions for
                    <strong>@Model.PlantName</strong>.
                </p>
            </div>

            <div class="form-card mb-4">
                <div class="form-card-accent"></div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="PlantHealth" method="post" id="ai-form">

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"
                             role="alert">
                        </div>

                        <input type="hidden"
                               asp-for="PlantId" />
                        <input type="hidden"
                               asp-for="PlantName" />


                        <!-- Symptoms -->

                        <div class="mb-4">

                            <label asp-for="Symptoms"
                                   class="form-label">
                                Symptoms
                            </label>

                            <textarea asp-for="Symptoms"
                                      class="form-control"
                                      rows="4"
                                      placeholder="Describe what you notice about the plant..."></textarea>

                            <div class="form-text">
                                Example: Leaves are turning yellow and the
                                soil stays wet for several days.
                            </div>

                            <span asp-validation-for="Symptoms"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Environment -->

                        <div class="mb-4">

                            <label asp-for="Environment"
                                   class="form-label">
                                Growing Environment
                            </label>

                            <textarea asp-for="Environment"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Describe sunlight, location, watering conditions, humidity, etc."></textarea>

                            <div class="form-text">
                                Example: Indoor, near a window, low sunlight,
                                watered twice a week.
                            </div>

                            <span asp-validation-for="Environment"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Additional Notes -->

                        <div class="mb-4">

                            <label asp-for="AdditionalNotes"
                                   class="form-label">
                                Additional Notes
                                <span class="text-muted fw-normal">
                                    (Optional)
                                </span>
                            </label>

                            <textarea asp-for="AdditionalNotes"
                                      class="form-control"
                                      rows="3"
                                      placeholder="Anything else you want the AI to know..."></textarea>

                            <span asp-validation-for="AdditionalNotes"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- Buttons -->

                        <div class="d-flex gap-2">

                            <button type="submit" id="ai-submit-btn" class="btn btn-success btn-lg">
                                🤖 Analyze Plant
                            </button>

                            <a asp-controller="Plants"
                               asp-action="Details"
                               asp-route-id="@Model.PlantId"
                               class="btn btn-outline-secondary btn-lg">
                                Back to Plant
                            </a>

                        </div>

                    </form>

                </div>

            </div>


            @if (!string.IsNullOrWhiteSpace(Model.AnalysisResult))
            {
                <div class="card shadow-sm border-0 rounded-xl">

                    <div class="card-body p-4 p-md-5">

                        <div class="d-flex align-items-center gap-2 mb-3">
                            <span class="fs-4">🌿</span>
                            <h3 class="fw-bold mb-0">AI Analysis</h3>
                        </div>

                        <div class="ai-result">

                            @Html.Raw(Model.AnalysisResult)

                        </div>

                        <hr />

                        <p class="text-muted small mb-0">
                            AI-generated plant-care guidance is informational
                            and should not be treated as a professional diagnosis.
                        </p>

                    </div>

                </div>
            }

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        (function () {
            const form = document.getElementById('ai-form');
            const btn = document.getElementById('ai-submit-btn');
            if (form && btn) {
                form.addEventListener('submit', function () {
                    if (form.checkValidity()) {
                        btn.disabled = true;
                        btn.innerHTML = '🌱 Analyzing your plant...';
                    }
                });
            }
        })();
    </script>
}
