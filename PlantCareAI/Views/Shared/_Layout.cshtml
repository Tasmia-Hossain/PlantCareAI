<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PlantCareAI</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Ctext y='.9em' font-size='90'%3E%F0%9F%8C%B1%3C/text%3E%3C/svg%3E" />
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PlantCareAI.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @{
        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["action"]?.ToString();
    }
    <header>
        <nav class="navbar navbar-expand-lg navbar-light site-navbar sticky-top mb-0">
            <div class="container">
                <a class="navbar-brand brand-mark" asp-area="" asp-controller="Home" asp-action="Index">
                    <span class="brand-leaf">🌱</span>
                    PlantCareAI
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <ul class="navbar-nav flex-grow-1 gap-1">
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Dashboard" ? "active" : "")"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Plants" && currentAction == "Index" ? "active" : "")"
                                   asp-controller="Plants"
                                   asp-action="Index">
                                    My Plants
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Plants" && currentAction == "Create" ? "active" : "")"
                                   asp-controller="Plants"
                                   asp-action="Create">
                                    Add Plant
                                </a>
                            </li>
                        </ul>
                    }
                    else
                    {
                        <ul class="navbar-nav flex-grow-1 gap-1">
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                    Home
                                </a>
                            </li>
                        </ul>
                    }
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-5">
                    <div class="brand-mark mb-2">
                        <span class="brand-leaf">🌱</span>
                        PlantCareAI
                    </div>
                    <p class="mb-0" style="max-width:34ch; opacity:.85;">
                        A calm, refreshing home for every plant you love — watering
                        schedules, health notes, and AI-backed care guidance in one place.
                    </p>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="text-uppercase mb-3" style="color:#fdfbf3; letter-spacing:.06em; font-size:.8rem;">Navigate</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li><a asp-controller="Plants" asp-action="Index">My Plants</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-4">
                    <h6 class="text-uppercase mb-3" style="color:#fdfbf3; letter-spacing:.06em; font-size:.8rem;">Account</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                        @if (!(User.Identity?.IsAuthenticated ?? false))
                        {
                            <li><a asp-area="Identity" asp-page="/Account/Login">Login</a></li>
                            <li><a asp-area="Identity" asp-page="/Account/Register">Register</a></li>
                        }
                    </ul>
                </div>
            </div>
            <hr class="footer-divider my-4" />
            <div class="d-flex flex-wrap justify-content-between gap-2 small" style="opacity:.7;">
                <span>&copy; @DateTime.Now.Year PlantCareAI. Grown with care 🌿</span>
            </div>
        </div>
    </footer>

    <!-- Shared "confirm delete" modal, used across the app instead of the browser's native confirm() -->
    <div class="modal fade" id="confirmDeleteModal" tabindex="-1" aria-labelledby="confirmDeleteModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content confirm-delete-modal">
                <div class="modal-body text-center p-4 p-md-5">
                    <div class="empty-icon" style="background:#fbeee9; margin:0 auto 1.1rem;">🗑️</div>
                    <h4 class="fw-bold mb-2" id="confirmDeleteModalLabel">Are you sure?</h4>
                    <p class="text-muted mb-4" id="confirmDeleteMessage">
                        This action can't be undone.
                    </p>
                    <div class="d-flex justify-content-center gap-2">
                        <button type="button" class="btn btn-outline-secondary btn-lg" data-bs-dismiss="modal">
                            Cancel
                        </button>
                        <button type="button" class="btn btn-danger btn-lg" id="confirmDeleteButton">
                            Yes, Delete
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
