@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-xl">
                <div class="card-body p-4 p-md-5 text-center">

                    <div class="empty-icon" style="background:#fbeee9;">🥀</div>

                    <h1 class="fw-bold mb-2">Something wilted.</h1>
                    <p class="text-muted mb-4">
                        An error occurred while processing your request.
                    </p>

                    @if (Model.ShowRequestId)
                    {
                        <p class="small text-muted">
                            <strong>Request ID:</strong> <code>@Model.RequestId</code>
                        </p>
                    }

                    <a asp-controller="Home" asp-action="Index" class="btn btn-success btn-lg mt-2">
                        Back to Safety
                    </a>

                    <hr class="my-4" />

                    <p class="small text-muted mb-1">
                        <strong>Development Mode:</strong> Swapping to the
                        <strong>Development</strong> environment will display more
                        detailed information about the error that occurred.
                    </p>
                    <p class="small text-muted mb-0">
                        The Development environment shouldn't be enabled for deployed
                        applications, as it can expose sensitive information from
                        exceptions to end users. For local debugging, set the
                        <strong>ASPNETCORE_ENVIRONMENT</strong> environment variable to
                        <strong>Development</strong> and restart the app.
                    </p>

                </div>
            </div>
        </div>
    </div>
</div>
